<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      零侵入日志上报到 OpenObserve：
      OTel Agent 2.x 通过 Logback instrumentation 自动注入 trace_id/span_id 到 MDC，
      并通过 -Dotel.logs.exporter=otlp 把日志事件批量上报到 OpenTelemetry Collector
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>{"timestamp":"%d{yyyy-MM-dd HH:mm:ss.SSS}","thread":"%thread","level":"%level","logger":"%logger{36}","trace_id":"%mdc{trace_id:-}","span_id":"%mdc{span_id:-}","message":"%msg"}%n</pattern>

        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="com.skyowl" level="DEBUG" />
    <logger name="org.springframework" level="WARN" />
    <logger name="org.hibernate" level="WARN" />
    <logger name="io.opentelemetry" level="WARN" />
</configuration>